{
    "name": "kommandhub/paystack",
    "description": "A framework-agnostic PHP library for integrating Paystack payments using SOLID principles and PSR standards.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "paystack",
        "php",
        "library",
        "payment",
        "gateway",
        "nigeria",
        "africa",
        "laravel"
    ],
    "authors": [
        {
            "name": "Anitche Chisom",
            "email": "admin@kommandhub.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kommandhub\\Paystack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kommandhub\\Paystack\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "php-http/mock-client": "^1.5",
        "nyholm/psr7": "^1.5",
        "symfony/http-client": "^6.0 || ^7.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.0",
        "vlucas/phpdotenv": "^5.6",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "mockery/mockery": "^1.6"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kommandhub\\Paystack\\Laravel\\PaystackServiceProvider"
            ],
            "aliases": {
                "Paystack": "Kommandhub\\Paystack\\Laravel\\Facades\\Paystack"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": "php -d error_reporting='E_ALL & ~E_DEPRECATED' vendor/bin/phpunit --testdox",
        "lint": "vendor/bin/phpstan analyse src --level=5",
        "format": "vendor/bin/php-cs-fixer fix"
    }
}
